					"script": {
						"exec": [
							"// Test 1: Check if response is successful\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Test 2: Check response time is reasonable\r",
							"pm.test(\"Response time is less than 5 seconds\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
							"});\r",
							"\r",
							"// Test 3: Check response has JSON body\r",
							"pm.test(\"Response has JSON body\", function () {\r",
							"    pm.response.to.have.jsonBody();\r",
							"});\r",
							"\r",
							"// Test 4: Check response contains simplified text\r",
							"pm.test(\"Response contains simplified field\", function () {\r",
							"    pm.expect(pm.response.json()).to.have.property('simplified');\r",
							"});\r",
							"\r",
							"// Test 5: Check simplified text is a string\r",
							"pm.test(\"Simplified text is a string\", function () {\r",
							"    pm.expect(pm.response.json().simplified).to.be.a('string');\r",
							"});\r",
							"\r",
							"// Test 6: Check simplified text is not empty\r",
							"pm.test(\"Simplified text is not empty\", function () {\r",
							"    pm.expect(pm.response.json().simplified.length).to.be.greaterThan(0);\r",
							"});\r",
							"\r",
							"// Save the simplified text as variable for other requests (optional)\r",
							"pm.test(\"Save simplified text as variable\", function () {\r",
							"    const response = pm.response.json();\r",
							"    pm.collectionVariables.set('simplified_text', response.simplified);\r",
							"});"
						],
