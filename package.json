{
  "name": "clausebusters",
  "version": "1.0.0",
  "description": "Hackathon project with Express, Winston, and Morgan logging",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest __tests__/app.tests.js",
    "test:integration": "jest __tests__/simplify.integration.test.js",
    "test:e2e": "npx cypress run --browser chrome",
    "test:e2e:open": "cypress open",
    "test:api": "newman run tests/postman/postman-collection.json",
    "test:api:ci": "newman run tests/postman/postman-collection.json --reporters cli,junit --reporter-junit-export tests/results/api-test-results.xml"
  },
  "author": "Your Name",
  "license": "Apache-2.0",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.0",
    "redis": "^5.8.2",
    "winston": "^3.10.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "cypress": "^15.1.0",
    "jest": "^30.1.3",
    "newman": "^6.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}